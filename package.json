{
    "name": "@bfmeta/node-sdk",
    "version": "5.1.0",
    "description": "bfmeta node sdk for js",
    "type": "module",
    "exports": {
        ".": {
            "types": "./build/src/index.d.ts",
            "default": "./build/src/index.js"
        }
    },
    "scripts": {
        "lsts": "node ./scripts/listAllFile.js",
        "clear": "node ./scripts/rmBuild.js",
        "dev": "tsc --build -w",
        "build": "tsc --build ./tsconfig.all.json",
        "rebuild": "pnpm clear & pnpm build"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:BioforestChain/BFMeta-Node-SDK.git"
    },
    "author": "BFMeta Team",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^18.15.3",
        "node-fetch": "^3.3.1",
        "oxlint": "^1.12.0",
        "tslib": "^2.4.1",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@bfmeta/sign-util": "^2.1.0",
        "@types/socket.io-client": "^1.4.36",
        "socket.io-client": "^2.4.0"
    },
    "files": [
        "build/*"
    ]
}
